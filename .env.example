# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Base URL of the event-search backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# auto   - try the API, fall back to the bundled snapshot in public/data (default)
# api    - API only; show an error if it is unreachable
# static - bundled snapshot only (use for hosted previews where localhost is not reachable)
VITE_DATA_SOURCE=auto
